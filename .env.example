# Keep secrets in .env, which is excluded from Git.
PORT=3000
HOST=127.0.0.1
# demo or cricketdata
SCORE_PROVIDER=demo
CRICKETDATA_API_KEY=
CRICKETDATA_MATCH_ID=
# Only enable WBBL frequencies after verifying the provider's competition.
VERIFIED_COMPETITION=
# Snapshot interval, NOT a promise of provider update speed.
POLL_SECONDS=120
# Local per-UTC-day budget; other uses of your API key still consume its allowance.
DAILY_REQUEST_BUDGET=95
# Optional, explicit revised innings limit, e.g. 90 for 15 overs.
SCHEDULED_BALLS=120
